{
	"name": "poly",
	"private": true,
	"version": "1.1.0",
	"description": "A modern, offline-first Warehouse Management System",
	"author": "Nam Nguyễn <namnts01718@gmail.com>",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"electron": "concurrently \"vite dev\" \"wait-on http://localhost:5173 && electron .\"",
		"electron:build": "vite build && electron-builder --win --mac --linux"
	},
	"build": {
		"appId": "com.poly.app",
		"productName": "PolyWMS",
		"publish": {
			"provider": "github",
			"owner": "Ic0u",
			"repo": "PolyWMS"
		},
		"directories": {
			"output": "dist"
		},
		"files": [
			"build/**/*",
			"electron/**/*",
			"package.json"
		],
		"mac": {
			"icon": "build-resources/icon.icns",
			"target": [
				{ "target": "dmg", "arch": ["x64", "arm64", "universal"] },
				{ "target": "zip", "arch": ["x64", "arm64", "universal"] }
			]
		},
		"win": {
			"icon": "build-resources/icon.png",
			"target": [
				{ "target": "nsis", "arch": ["x64", "arm64", "ia32"] }
			]
		},
		"linux": {
			"icon": "build-resources/icon.png",
			"target": [
				{ "target": "AppImage", "arch": ["x64", "arm64"] },
				{ "target": "deb",      "arch": ["x64", "arm64"] },
				{ "target": "rpm",      "arch": ["x64", "arm64"] }
			],
			"category": "Office"
		}
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"concurrently": "^9.0.0",
		"electron": "^33.0.0",
		"electron-builder": "^25.0.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wait-on": "^8.0.0"
	}
}
